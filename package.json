{
  "name": "reveal-obsidian-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run esbuild.config.mjs",
    "build": "bun run typecheck && bun run esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "check": "bun run lint && bun run test && bun run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.7.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.37.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  }
}
